// A 2D array made in a function and filled in another: a quarter turn
type
  TMatrix = array of array of Int32;

function Make(W, H: Int32): TMatrix;
begin
  SetLength(Result, H, W);
end;

function Rot90(M: TMatrix): TMatrix;
var
  x, y: Int32;
begin
  Result := Make(Length(M), Length(M[0]));
  for y := 0 to High(M) do
    for x := 0 to High(M[0]) do
      Result[x][High(M) - y] := M[y][x];
end;

var
  M: TMatrix;
begin
  M := Make(3, 2);
  M[0] := [1, 2, 3];
  M[1] := [4, 5, 6];
  WriteLn(Rot90(M));
end.
