{$assertions on}

const
  CURRENT_FILE = {$MACRO FILE};

procedure Foo;
begin
  raise 'Foo';
end;

procedure Bar;
begin
  Foo();
end;

begin
  try
    Bar();
  except
    Assert(GetExceptionMessage() = 'Foo');
    Assert(GetExceptionLocationStr() = 'line 8, column 3 in file "' + CURRENT_FILE + '"');
  end;
end;

procedure ReRaise;
begin
  try
    raise 'ReRaise';
  except
    raise;
  end;
end;

begin
  try
    ReRaise();
  except
    Assert(GetExceptionMessage() = 'ReRaise');
    Assert(GetExceptionLocationStr() = 'line 28, column 5 in file "' + CURRENT_FILE + '"');
  end;
end;
