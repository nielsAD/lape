// What is declared later can be addressed, as it can be called
type
  T = record x: Int32; end;

procedure T.Go;
var
  p: procedure of object;
begin
  p := @Self.Later;
  p();
end;

procedure Early;
var
  p: procedure;
begin
  p := @Later;
  p();
end;

procedure T.Later;
begin
  WriteLn('method ', Self.x);
end;

procedure Later;
begin
  WriteLn('global');
end;

var
  r: T = [5];
begin
  r.Go();
  Early();
end.
