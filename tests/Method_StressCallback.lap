type
  TStrF = function(s: String): String;
  TIntF = function(x, y: Int64): Int64;
  TUnF = function(x: Int64): Int64;
  TCounter = record
    n: Int64;
  end;
  TCount = function(x: Int64): Int64 of object;

function Shout(s: String): String;
begin
  Result := s + '!';
end;

function Echo(s: String): String;
begin
  Result := s + s;
  SetLength(Result, Length(s));
end;

function Add(x, y: Int64): Int64;
begin
  Result := x + y;
end;

function Sub(x, y: Int64): Int64;
begin
  Result := x - y;
end;

function TCounter.Step(x: Int64): Int64;
begin
  Self.n += x;
  Result := Self.n;
end;

function TCounter.Back(x: Int64): Int64;
begin
  Self.n -= x;
  Result := Self.n;
end;

var
  Down: TUnF;

function Depth(x: Int64): Int64;
begin
  if (x = 0) then
    Exit(0);
  Result := Down(x - 1) + 1;
end;

function Apply(f: TIntF; x, y: Int64): Int64;
begin
  Result := f(x, y);
end;

function Fold(Fs: array of TIntF; n: Int32): Int64;
var
  i: Int32;
begin
  Result := 0;
  for i := 1 to n do
    Result := Apply(@Fs[i mod Length(Fs)], Result, i);
end;

function Bad(s: String): String;
begin
  if (s = 'x') then
    raise 'bad ' + s;
  Result := s;
end;

var
  StrFs: array of TStrF;
  IntFs: array of TIntF;
  Counts: array of TCount;
  c: array of TCounter;
  f, g: TStrF;
  n: function(s: String): Int32;
  s: String;
  i, Len, Caught: Int64;
begin
  // script and imported methods in the same variables, results in one expression
  StrFs := [@LowerCase, @Shout, @UpperCase, @Echo];
  Len := 0;
  for i := 0 to 9999 do
  begin
    s := StrFs[i mod 4]('Ab') + StrFs[(i + 1) mod 4](IntToStr(i));
    Len += Length(s);
  end;
  WriteLn('strings ', Len, ' ', StrFs[0]('XY') + StrFs[1]('a') + StrFs[2]('b') + StrFs[3]('cd'));

  f := @Shout;
  g := @UpperCase;
  s := 'go';
  for i := 1 to 3 do
  begin
    if (i mod 2 = 1) then
      s := f(g(f(s)))
    else
      s := g(f(g(s)));
  end;
  WriteLn('nested ', s);

  // passed on as a parameter, of both kinds
  IntFs := [@Add, @Max, @Sub, @Min];
  WriteLn('fold ', Fold(IntFs, 100000), ' ', Fold([@Max], 1000), ' ', Fold([@Add], 1000));
  WriteLn('mixed ', IntFs[0](1, 2) * IntFs[1](3, 4) - IntFs[2](10, 5) + IntFs[3](IntFs[0](1, 1), IntFs[1](0, 7)));

  // recursion through a method variable
  Down := @Depth;
  WriteLn('depth ', Down(2000), ' ', Depth(1500));

  // of object, on records of an array
  SetLength(c, 3);
  SetLength(Counts, 6);
  for i := 0 to 2 do
  begin
    Counts[i * 2] := @c[i].Step;
    Counts[i * 2 + 1] := @c[i].Back;
  end;
  for i := 1 to 60000 do
    Counts[i mod 6](i mod 7);
  WriteLn('counters ', c[0].n, ' ', c[1].n, ' ', c[2].n);

  // exceptions out of either kind
  Caught := 0;
  StrFs := [@Bad, @LowerCase];
  n := @StrToInt;
  for i := 0 to 999 do
  try
    if (i mod 2 = 0) then
      StrFs[0]('x')
    else
      n(StrFs[1]('x'));
  except
    Caught += 1;
  end;
  WriteLn('caught ', Caught);
end.
