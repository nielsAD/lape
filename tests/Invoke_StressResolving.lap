type
  TP = record X, Y: Int32; end;
  TBox = record X1, Y1, X2, Y2: Int32; end;

function K(x: Int8): String; overload; begin Result := 'i8'; end;
function K(x: Int32): String; overload; begin Result := 'i32'; end;
function K(x: Int64): String; overload; begin Result := 'i64'; end;
function K(x: Double): String; overload; begin Result := 'dbl'; end;
function K(x: String): String; overload; begin Result := 'str'; end;
function K(x: Char): String; overload; begin Result := 'chr'; end;
function K(x: Boolean): String; overload; begin Result := 'bool'; end;
function K(x: TP): String; overload; begin Result := 'point'; end;
function K(x: TBox): String; overload; begin Result := 'box'; end;
function K(x: array of Int32): String; overload; begin Result := 'ints'; end;
function K(x: array of String): String; overload; begin Result := 'strs'; end;
function K(x, y: Int32): String; overload; begin Result := 'two'; end;

function R(x: Int32): Int32; overload; begin Result := x * 2; end;
function R(x: Int32): String; overload; begin Result := '<' + IntToStr(x) + '>'; end;
function R(x: Int32): Double; overload; begin Result := x / 4; end;

function TP.Add(o: TP): TP; overload; begin Result.X := Self.X + o.X; Result.Y := Self.Y + o.Y; end;
function TP.Add(n: Int32): TP; overload; begin Result.X := Self.X + n; Result.Y := Self.Y + n; end;

var
  i8: Int8; i32: Int32; i64: Int64; d: Double; ch: Char; b: Boolean;
  p: TP; bx: TBox;
  ints: array of Int32; strs: array of String;
  s: String; n: Int32; f: Double;
  i: Int32;
begin
  WriteLn(K(i8), ' ', K(i32), ' ', K(i64), ' ', K(d), ' ', K('s'), ' ', K(ch), ' ', K(b));
  WriteLn(K(p), ' ', K(bx), ' ', K(ints), ' ', K(strs), ' ', K(1, 2));
  // (Int64: of a number on its own, the type is that of a native integer, which an array of Int32 fits on 32 bit)
  WriteLn(K([Int64(1), 2]), ' ', K([Int64(1), 2, 3, 4]), ' ', K(['ab', 'cd']));

  s := R(3); n := R(3); f := R(3);
  WriteLn(s, ' ', n, ' ', Round(f * 100));

  s := '';
  n := 0;
  for i := 1 to 300 do
  begin
    s := R(i mod 10);
    n := n + R(i) + Length(s);
  end;
  WriteLn(n, ' ', s);

  p.X := 1; p.Y := 2;
  for i := 1 to 20 do
    p := p.Add(1).Add(p);
  WriteLn(p.X, ' ', p.Y);
end.
