{$assertions on}
// An open array after `in` is a set: operators are for what is typed
var success: Boolean;

operator in(l: Int32; r: array of Int32): Boolean;
begin
  success := True;
end;

operator in(l: Char; r: String): Boolean;
begin
  success := True;
end;

var
  i: Int32;
  b: Boolean;
begin
  success := False;
  i := 100;
  b := i in [0, 1, 50];
  Assert(not success);
  Assert(not b);

  success := False;
  b := 'z' in 'abc';
  Assert(success);
end;
