type TF = function: Int32;
function Five: Int32; begin Result := 5; end;
function GetF: TF; begin Result := @Five; end;
var f: TF; p: Pointer;
begin
  f := nil;
  WriteLn(Assigned(f), ' ', Assigned(@f));
  f := @Five;
  WriteLn(Assigned(f), ' ', Assigned(@f), ' ', f());
  p := nil; WriteLn(Assigned(p));
  WriteLn(Assigned(GetF()));
end.
