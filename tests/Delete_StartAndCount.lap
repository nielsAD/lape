var
  a: array of Int32;
  s: array of String;
  str: String;

procedure Start;
begin
  a := [1, 2, 3];
  // (made at run time: strings that are let go of when they are deleted)
  s := [IntToStr(1), IntToStr(2), IntToStr(3)];
  str := 'abc';
end;

procedure Show(Name: String);
begin
  WriteLn('  ', Name, ': ', a, ' ', s, ' ''', str, '''');
end;

procedure Test(From, Count: SizeInt);
begin
  Start();
  Delete(a, From, Count);
  Delete(s, From, Count);
  Delete(str, From, Count);
  Show(IntToStr(From) + ', ' + IntToStr(Count));
end;

begin
  WriteLn('before the start');
  Test(-1, 2);
  Test(-4, 2);
  Test(-1, 3);
  Test(-1, 4);
  Test(-1, 10);
  Test(-4, 10);
  Test(-100, 1);
  Test(-1, 0);
  Test(-1, -1);

  WriteLn('at or past the end');
  Test(3, 1);
  Test(4, 1);
  Test(5, 2);

  WriteLn('more than there is');
  Test(0, 10);
  Test(1, 9);
  Test(2, 2);

  WriteLn('none or fewer');
  Test(0, 0);
  Test(1, 0);
  Test(1, -1);

  WriteLn('in the array');
  Test(0, 1);
  Test(1, 1);
  Test(2, 1);
  Test(0, 2);
  Test(1, 2);
  Test(0, 3);

  WriteLn('count left out');
  Start(); Delete(a, -1); Delete(s, -1); Delete(str, -1); Show('-1');
  Start(); Delete(a, 0); Delete(s, 0); Delete(str, 0); Show('0');
  Start(); Delete(a, 1); Delete(s, 1); Delete(str, 1); Show('1');
  Start(); Delete(a, 3); Delete(s, 3); Delete(str, 3); Show('3');

  WriteLn('nothing there');
  a := nil; s := nil; str := '';
  Delete(a, -1, 2); Delete(s, -1, 2); Delete(str, -1, 2);
  Delete(a, 0, 1); Delete(s, 0, 1); Delete(str, 0, 1);
  Show('-1, 2 and 0, 1');
end.
