// A type's name: its members, its range, as what a value is of
type
  TColor = (Red, Green, Blue);
  TPoint = record
    X, Y: Int32;
    const Scale = 10;
  end;
  PPoint = ^TPoint;

function TPoint.Make(x: Int32): TPoint; static;
begin
  Result.X := x * Self.Scale;
  Result.Y := Self.Scale;
end;

var
  p: TPoint;
  pp: PPoint;
  q: PType(pp);
  c: TColor;
begin
  WriteLn(TColor.Green, ' ', Low(TColor), ' ', High(TColor), ' ', Length(TColor));
  WriteLn(TPoint.Scale, ' ', SizeOf(TPoint));
  p := TPoint.Make(3);
  WriteLn(p.X, ' ', p.Y);
  q := Default(TPoint);
  WriteLn(q.X);
  for c in TColor do
    Write(c, ' ');
  WriteLn();
end.
