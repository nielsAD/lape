function A(x: Int32): Int32; overload;
begin
  Result := x + 1;
end;

function A(x: Double): Double; overload;
begin
  Result := x / 2;
end;

function A(s: String): String; overload;
begin
  Result := s + 'a';
end;

function B(x, y: Int32): Int32;
begin
  Result := x * 3 - y;
end;

function C(s: String; n: Int32): String;
begin
  Result := s + IntToStr(n);
end;

function Len(s: String): Int32;
begin
  Result := Length(s);
end;

var
  i, Sum, Zero: Int32;
  s: String;
  d: Double;
begin
  Zero := 0;
  WriteLn(A(A(A(A(A(A(A(A(A(A(Zero)))))))))));
  WriteLn(B(A(1), B(A(2), B(A(3), B(A(4), B(A(5), A(6)))))));
  WriteLn(A(A(A(A('')))));
  WriteLn(C(C(C(A('x'), A(1)), B(2, 1)), Len(C(A('y'), B(A(1), A(0))))));

  d := A(A(A(16.0)));
  WriteLn(Round(d * 100));

  Sum := 0;
  for i := 1 to 1000 do
    Sum := Sum + B(A(i), A(A(i))) + Len(C(A(''), A(i)));
  WriteLn(Sum);

  s := '';
  for i := 1 to 50 do
    s := C(A(s), Len(A(s)) mod 7);
  WriteLn(Length(s), ' ', Copy(s, 1, 12));
end.
