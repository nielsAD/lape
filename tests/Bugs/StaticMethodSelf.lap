{$assertions on}

type
  TPoint = record
    const z = 15;
    const w = 25;
    x, y: Integer;
  end;
  TPointArray = array of TPoint;

function TPoint.GetZ: Integer; static;
begin
  Result := Self.z;
end;

procedure TPoint.TestZ; static;
begin
  Assert(Self.z = 15);
  Assert(Self.GetZ() = 15);
end;

function TPoint.GetW: Integer; static;
begin
  Result := Self.w;
end;

procedure TPoint.TestW; static;
begin
  Assert(Self.w = 25);
  Assert(Self.GetW() = 25);
end;

begin
  TPoint.TestZ();
  TPoint.TestW();
end.