type EFoo = (aaa,bbb,ccc,zzz);
type ERange = bbb..zzz;
type TRangeSet = set of ERange;
type TCharSet = set of AnsiChar;

var
  s: TCharSet;
  rs: TRangeSet;
  e: ERange;
  c: AnsiChar;
  foo: EFoo;
begin
  for foo in [aaa, ccc..zzz] do
    WriteLn(foo);

  s := ['a'..'l', 'x'..'y'];
  for c in s do
    Write(c, ' ');
  WriteLn();

  rs := [bbb, ccc..zzz];
  for e in rs do
    Write(e, ' ');
  WriteLn();
end;
