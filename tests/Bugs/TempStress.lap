function MkInt64(v: Int32): Int64; begin Result := Abs(v) mod 20; end;
function IdInt64(const v: Int64): Int64; begin Result := v; end;
procedure AddInt64(var v: Int64; d: Int64); begin v := v + d; end;

procedure TestInt64(k: Int32);
var
  a, b, c: Int64;
  arr: array of Int64;
  sa: array[0..3] of Int64;
  i: Int32;
begin
  a := MkInt64(k + 3);
  b := MkInt64(k + 5);
  Assert(MkInt64(k + 3) + MkInt64(k + 5) = a + b);
  Assert(MkInt64(k + 3) * MkInt64(k + 5) - MkInt64(k + 3) = a * b - a);
  Assert(IdInt64(IdInt64(MkInt64(k + 3))) + IdInt64(MkInt64(k + 5)) = a + b);
  Assert((MkInt64(k + 3) < MkInt64(k + 5)) = (a < b));
  Assert((MkInt64(k + 3) = MkInt64(k + 3)) and (MkInt64(k + 5) <> MkInt64(k + 3) + 1));
  c := MkInt64(k + 3);
  c += MkInt64(k + 5);
  Assert(c = a + b);
  AddInt64(c, MkInt64(k + 3));
  Assert(c = a + b + a);
  arr := [MkInt64(1), MkInt64(2), MkInt64(3), MkInt64(4)];
  arr[Idx(k)] := MkInt64(k + 5) + MkInt64(k + 3);
  Assert(arr[Idx(k)] = a + b);
  sa[Idx(k + 1)] := MkInt64(k + 3) * MkInt64(2);
  Assert(sa[Idx(k + 1)] = a * 2);
  c := 0;
  for i := 0 to 9 do
    c := c + MkInt64(i) + IdInt64(MkInt64(i));
  Assert(c = 90);
  if (MkInt64(k + 3) > MkInt64(k + 5)) then c := MkInt64(k + 3) else c := MkInt64(k + 5);
  if (a > b) then Assert(c = a) else Assert(c = b);
  case MkInt64(k + 3) of
    MkInt64(0), MkInt64(1) + MkInt64(0): i := 1;
    MkInt64(2)..MkInt64(Twice(2)): i := 2;
    MkInt64(k + 3): i := 3;
  else
    i := 4;
  end;
  if (a <= MkInt64(4)) then Assert(i = 2) else Assert(i = 3);
  arr := [MkInt64(5), MkInt64(6), MkInt64(7), MkInt64(8)];
  c := arr.Remove(MkInt64(k + 6)) + MkInt64(k + 3);
  Assert((c = MkInt64(k + 6) + a) and (Length(arr) = 3));
  Assert(arr.Remove(MkInt64(99)) + MkInt64(k + 5) = b);
  WriteLn('Int64 ', MkInt64(k + 3) + MkInt64(k + 5), ' ', MkInt64(k + 5) * MkInt64(2), ' ', arr[0] + arr[2]);
end;

function MkUInt64(v: Int32): UInt64; begin Result := Abs(v) mod 20; end;
function IdUInt64(const v: UInt64): UInt64; begin Result := v; end;
procedure AddUInt64(var v: UInt64; d: UInt64); begin v := v + d; end;

procedure TestUInt64(k: Int32);
var
  a, b, c: UInt64;
  arr: array of UInt64;
  sa: array[0..3] of UInt64;
  i: Int32;
begin
  a := MkUInt64(k + 3);
  b := MkUInt64(k + 5);
  Assert(MkUInt64(k + 3) + MkUInt64(k + 5) = a + b);
  Assert(MkUInt64(k + 3) * MkUInt64(k + 5) - MkUInt64(k + 3) = a * b - a);
  Assert(IdUInt64(IdUInt64(MkUInt64(k + 3))) + IdUInt64(MkUInt64(k + 5)) = a + b);
  Assert((MkUInt64(k + 3) < MkUInt64(k + 5)) = (a < b));
  Assert((MkUInt64(k + 3) = MkUInt64(k + 3)) and (MkUInt64(k + 5) <> MkUInt64(k + 3) + 1));
  c := MkUInt64(k + 3);
  c += MkUInt64(k + 5);
  Assert(c = a + b);
  AddUInt64(c, MkUInt64(k + 3));
  Assert(c = a + b + a);
  arr := [MkUInt64(1), MkUInt64(2), MkUInt64(3), MkUInt64(4)];
  arr[Idx(k)] := MkUInt64(k + 5) + MkUInt64(k + 3);
  Assert(arr[Idx(k)] = a + b);
  sa[Idx(k + 1)] := MkUInt64(k + 3) * MkUInt64(2);
  Assert(sa[Idx(k + 1)] = a * 2);
  c := 0;
  for i := 0 to 9 do
    c := c + MkUInt64(i) + IdUInt64(MkUInt64(i));
  Assert(c = 90);
  if (MkUInt64(k + 3) > MkUInt64(k + 5)) then c := MkUInt64(k + 3) else c := MkUInt64(k + 5);
  if (a > b) then Assert(c = a) else Assert(c = b);
  case MkUInt64(k + 3) of
    MkUInt64(0), MkUInt64(1) + MkUInt64(0): i := 1;
    MkUInt64(2)..MkUInt64(Twice(2)): i := 2;
    MkUInt64(k + 3): i := 3;
  else
    i := 4;
  end;
  if (a <= MkUInt64(4)) then Assert(i = 2) else Assert(i = 3);
  arr := [MkUInt64(5), MkUInt64(6), MkUInt64(7), MkUInt64(8)];
  c := arr.Remove(MkUInt64(k + 6)) + MkUInt64(k + 3);
  Assert((c = MkUInt64(k + 6) + a) and (Length(arr) = 3));
  Assert(arr.Remove(MkUInt64(99)) + MkUInt64(k + 5) = b);
  WriteLn('UInt64 ', MkUInt64(k + 3) + MkUInt64(k + 5), ' ', MkUInt64(k + 5) * MkUInt64(2), ' ', arr[0] + arr[2]);
end;

