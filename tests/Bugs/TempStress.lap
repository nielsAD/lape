procedure TestRecords(k: Int32);
var
  t, u: TP;
  vq: TQ;
  vra: TRA;
  vrs: TRS;
  i, s: Int32;

  function Inner(v: Int32): Int32;
  begin
    Result := P(v, k).Len() + SumP(P(k, v));
  end;

begin
  t := P(k, k + 1);
  u := P(k + 2, k + 3);
  Assert(SumP(P(k, k + 1)) + SumPRef(P(k + 2, k + 3)) = SumP(t) + SumPRef(u));
  Assert(SumPVal(P(k, k + 1)) + SumPVal(P(k + 2, k + 3)) = SumPVal(t) + SumPVal(u));
  Assert(P(k, k + 1).Len() + P(k + 2, k + 3).Len() = t.Len() + u.Len());
  Assert(P(k, k + 1).x + P(k + 2, k + 3).y = t.x + u.y);
  Assert(Q(k).p.y + Q(k + 1).a = k + 1 + k + 1);
  Assert(Q(k).d + Q(k + 2).d = (k + k + 2) / 2);
  Assert((P(k, k + 1) = t) and (P(k + 2, k + 3) <> t));
  BumpP(t);
  Assert(t.x = k + 10);
  MakeP(u, Twice(k));
  Assert((u.x = k * 2) and (u.y = -k * 2));
  with P(Twice(k), Idx(k)) do
    Assert(x + y = Twice(k) + Idx(k));
  with Q(Twice(k)) do
    Assert(p.x + a = Twice(k) * 2);
  vra := RA(k);
  Assert(RA(k).sa[Idx(k)] + RA(k + 1).sa[3] = vra.sa[Idx(k)] + k + 4);
  Assert(SA(k)[Idx(k + 1)] + SA(k + 1)[0] = SA(k)[Idx(k + 1)] + (k + 1) * 2);
  vrs := RS(k);
  Assert(RS(k).s + RS(k + 1).s = vrs.s + 'rs' + IntToStr(k + 1));
  Assert(RS(k).n + RS(k + 1).n = 2 * k + 1);
  s := 0;
  for i := 1 to 5 do
    s += Inner(i) - Inner(i - 1);
  Assert(s = Inner(5) - Inner(0));
  s := 0;
  i := 0;
  while (i < 4) do
  begin
    s += SumP(P(i, Twice(i)));
    Inc(i);
  end;
  repeat
    s -= P(i, i).Len();
    Dec(i);
  until (i < 0);
  WriteLn('records ', s, ' ', SumP(P(k, k + 1)), ' ', Q(k).p.x + RA(k).sa[2], ' ', Inner(k));
end;

procedure TestStrings(k: Int32);
var
  a, b: String;
  ssa, ssb: ShortString;
  ua, ub: UnicodeString;
  arr: TStrArray;
  i: Int32;
begin
  a := MkAS(k);
  b := MkAS(k + 1);
  Assert(MkAS(k) + MkAS(k + 1) = a + b);
  Assert((MkAS(k) + 'x') + (MkAS(k + 1) + 'y') = a + 'x' + b + 'y');
  Assert((MkAS(k) < MkAS(k + 1)) = (a < b));
  Assert(Length(MkAS(k) + MkAS(k + 1)) = Length(a) + Length(b));
  ssa := MkSS(k);
  ssb := MkSS(k + 1);
  Assert(MkSS(k) + MkSS(k + 1) = ssa + ssb);
  ua := MkUS(k);
  ub := MkUS(k + 1);
  Assert(MkUS(k) + MkUS(k + 1) = ua + ub);
  Assert(MkC(k) + MkC(k + 1) = Chr(65 + k mod 26) + Chr(65 + (k + 1) mod 26));
  Assert((MkC(k) < MkC(k + 1)) or (k mod 26 = 25));
  Assert(MkW(k) + MkW(k + 1) = WideChar(97 + k mod 26) + WideChar(97 + (k + 1) mod 26));
  arr := StrA(k) + StrA(k + 1);
  Assert(Length(arr) = 4);
  Assert(StrA(k)[0] + StrA(k + 1)[1] = arr[0] + arr[3]);
  a := '';
  for i := 0 to 4 do
    a += MkAS(i) + MkSS(i) + MkUS(i);
  Assert(Length(a) = 45);
  case MkAS(k) of
    'as0': i := 0;
    'as1', 'as2': i := 1;
  else
    i := 2;
  end;
  if (k = 0) then Assert(i = 0) else if (k <= 2) then Assert(i = 1) else Assert(i = 2);
  case MkAS(k) of
    MkAS(1), MkAS(2): i := 1;
    MkAS(0): i := 0;
  else
    i := 2;
  end;
  if (k = 0) then Assert(i = 0) else if (k <= 2) then Assert(i = 1) else Assert(i = 2);
  case MkC(k) of
    MkC(1), MkC(2): i := 1;
    MkC(0)..MkC(Idx(3)): i := 2;
  else
    i := 3;
  end;
  if (k = 0) then Assert(i = 2) else if (k <= 2) then Assert(i = 1) else Assert(i = 2);
  WriteLn('strings ', MkAS(k) + MkUS(k + 1), ' ', MkSS(k) + MkC(k) + MkW(k), ' ', Length(a));
end;

procedure TestOrdinals(k: Int32);
var
  e: TE;
  ss: TSmallSet;
  ls: TLargeSet;
  bl: Boolean;
  i: Int32;
begin
  e := MkE(k);
  Assert(Ord(MkE(k)) + Ord(MkE(k + 1)) = Ord(e) + (k + 1) mod 6);
  Assert((MkE(k) < MkE(k + 1)) = (k mod 6 < 5));
  Assert(MkE(k) in MkSmall(k));
  ss := MkSmall(k);
  Assert(MkSmall(k) + MkSmall(k + 1) = ss + MkSmall(k + 1));
  Assert(MkSmall(k) * MkSmall(k + 2) = ss * MkSmall(k + 2));
  Assert((MkSmall(k) - MkSmall(k + 2)) <= ss);
  ls := MkLarge(k);
  Assert(MkLarge(k) + MkLarge(k + 1) = ls + MkLarge(k + 1));
  Assert((Abs(k) mod 256) in MkLarge(k));
  bl := MkB(k);
  Assert((MkB(k) and MkB(k + 1)) = (bl and MkB(k + 1)));
  Assert((MkB(k) or not MkB(k + 2)) = (bl or not MkB(k + 2)));
  case MkE(k + 1) of
    e0, e1: i := 1;
    e2..e4: i := 2;
  else
    i := 3;
  end;
  if ((k + 1) mod 6 <= 1) then Assert(i = 1) else if ((k + 1) mod 6 <= 4) then Assert(i = 2) else Assert(i = 3);
  i := 0;
  case MkE(k + 2) of
    MkE(0): i := 1;
    MkE(1)..MkE(Twice(1)): i := 2;
    MkE(k + 2): i := 3;
  end;
  if (k = 0) then Assert(i = 2) else Assert(i = 3);
  case MkB(k) of
    MkB(0), MkB(3): i := 1;
    MkB(1): i := 2;
  end;
  if MkB(k) then Assert(i = 2) else Assert(i = 1);
  i := 0;
  for e := MkE(1) to MkE(4) do
    i += Ord(e) + Ord(MkE(Ord(e)));
  Assert(i = 20);
  WriteLn('ordinals ', Ord(MkE(k)) + Ord(MkE(k + 3)), ' ', MkB(k) xor MkB(k + 1), ' ', e1 in MkSmall(k));
end;

procedure TestPointersAndArrays(k: Int32);
var
  a: TIntArray;
  pp: ^Int32;
  f: TFn;
  v: Variant;
  i, s: Int32;
begin
  pp := PoolPtr(k);
  Assert(PoolPtr(k)^ + PoolPtr(k + 1)^ = pp^ + Pool[(k + 1) mod 10]);
  Assert((PoolPtr(k) = pp) and (PoolPtr(k + 1) <> pp));
  PoolPtr(k)^ := PoolPtr(k)^ + 0;
  a := IA(k);
  Assert(IA(k)[Idx(k) mod 3] + IA(k + 1)[2] = a[Idx(k) mod 3] + k + 8);
  Assert(Length(IA(k) + IA(k + 1)) = 6);
  a := IA(k) + IA(k + 1);
  Assert(a[3] + a[5] = k + 1 + k + 8);
  s := 0;
  for i in IA(k) do
    s += i;
  Assert(s = k + k * k + k + 7);
  f := Fn(k);
  Assert(Fn(k)(5) + Fn(k + 1)(6) = f(5) + Fn(k + 1)(6));
  v := MkV(k);
  Assert(MkV(k) + MkV(k + 1) = v + k + 1);
  Assert(Def(Twice(k)) + Def(k, Twice(2)) = Twice(k) * 4 + k * 4);
  Assert(Rec(Idx(k) + 2) + Rec(3) = Rec(Idx(k) + 2) + 11);
  WriteLn('pointers ', PoolPtr(k)^ + PoolPtr(k + 2)^, ' ', IA(k)[1] + IA(k)[2], ' ', Fn(k)(7), ' ', MkV(k) * MkV(2));
end;

// After managed call results, empty and literal values of the same types are made and read: such a value is read
// before it is written, which counts on its temporary being new (nil). That needs memory to be initialized.
procedure TestManaged(k: Int32);
var
  arr: TIntArray;
  str: String;
  r: TAR;
  i, s: Int32;
begin
  arr := GetArr();
  GetArr();
  Assert(ARV([]) + ARC([]) + ARRef([]) = 0);
  str := GetStr();
  GetStr();
  Assert(StrV('') + StrC('') = 0);
  Assert(ArrV([]) + ArrC([]) = 0);
  r := GetAR();
  GetAR();
  Assert(ARV([]) = 0);
  Assert(ARC(GetAR()) + ARV(GetAR()) = ARRef(GetAR()) * 2);
  Assert(ArrV(GetArr()) + ArrC([]) + ArrV([k]) = 4);
  Assert(StrV(GetStr()) + StrC('') > 0);
  Assert(ARV([[k, k], 'ab', '']) = 4);
  Assert(ARC([GetArr(), GetStr(), '']) = 3 + Length(IntToStr(Made)) + 3);
  s := 0;
  for i := 0 to 4 do
  begin
    arr := GetArr();
    s += ArrV(GetArr()) + ArrV([]) + ARV([]) + StrV(GetStr()) - StrV(GetStr());
    GetAR();
  end;
  Assert(s = 15);
  Assert(Length(arr) = 3);
  WriteLn('managed ', ARV([]), ' ', ArrV([]), ' ', StrV(''), ' ', ARV([[1], 'x', 'yz']));
end;

procedure TestExceptions(k: Int32);
var
  i, s: Int32;
begin
  s := 0;
  for i := 0 to 5 do
    try
      s += SumP(P(i, k));
      if (i mod 2 = 0) then
        raise 'odd ' + MkAS(i);
      s += Twice(i);
    except
      s += Idx(i) + Length(MkAS(i));
    finally
      s += P(i, i).Len() mod 3;
    end;
  Assert(s > 0);
  WriteLn('exceptions ', s);
end;

procedure TestAll(k: Int32);
begin
  TestInt8(k);
  TestUInt8(k);
  TestInt16(k);
  TestUInt16(k);
  TestInt32(k);
  TestUInt32(k);
  TestInt64(k);
  TestUInt64(k);
  TestSingle(k);
  TestDouble(k);
  TestCurrency(k);
  TestRecords(k);
  TestStrings(k);
  TestOrdinals(k);
  TestPointersAndArrays(k);
  TestManaged(k);
  TestExceptions(k);
end;

var
  m: Int32;
  t: TP;
begin
  // (only with memory initialized: TestManaged counts on it)
  {$IFDEF memoryinit}
  for m := 0 to 2 do
    TestAll(m);

  // and in the main block, where it is not a method's frame
  t := P(Twice(3), Idx(5));
  Assert(SumP(P(Twice(3), Idx(5))) + P(1, 2).Len() = SumP(t) + 3);
  Assert(MkAS(1) + MkUS(2) + MkSS(3) = 'as1us2ss3');
  Assert(MkInt64(3) + MkUInt64(4) * MkDouble(2) = 11);
  case Twice(4) of
    Twice(1), Twice(2): m := 1;
    Twice(3)..Twice(5): m := 2;
  else
    m := 3;
  end;
  Assert(m = 2);
  GetArr();
  GetArr();
  Assert(ARV([]) + ARC([]) + ARRef([]) = 0);
  GetStr();
  Assert(StrV('') = 0);
  WriteLn('main ', SumP(P(Twice(3), Idx(5))), ' ', MkAS(4) + MkC(5), ' ', Ord(MkE(9)));
  {$ENDIF}
end.
