    c := c + MkSingle(i) + IdSingle(MkSingle(i));
  Assert(c = 90);
  if (MkSingle(k + 3) > MkSingle(k + 5)) then c := MkSingle(k + 3) else c := MkSingle(k + 5);
  if (a > b) then Assert(c = a) else Assert(c = b);
  case MkSingle(k + 3) of
    MkSingle(0), MkSingle(1) + MkSingle(0): i := 1;
    MkSingle(2)..MkSingle(Twice(2)): i := 2;
    MkSingle(k + 3): i := 3;
  else
    i := 4;
  end;
  if (a <= MkSingle(4)) then Assert(i = 2) else Assert(i = 3);
  arr := [MkSingle(5), MkSingle(6), MkSingle(7), MkSingle(8)];
  c := arr.Remove(MkSingle(k + 6)) + MkSingle(k + 3);
