{$assertions on}

type
  EEnum = (e1,e2,e3,e4,e5,e6,e7,e9);

var
  e: EEnum;
  i: Int32;
  small: set of 0..31;
  c: AnsiChar;
begin
  e := e1;
  Assert(not (e in [e3,e2]));
  Assert(e in [e3,e2,e1]);
  e := e5;
  Assert(not (e in [e1,e2,e6..e9]));
  Assert(e in [e1,e2,e5..e9]);

  i := 100;
  Assert(not (i in [1..99]));
  Assert(i in [1..200]);

  // (a number the set cannot hold is not in it, also where it would wrap onto one that is)
  small := [4];
  i := 36;
  Assert(not (i in small));
  i := 356;
  Assert(not (i in [100]));
  i := -252;
  Assert(not (i in [4]));

  c := 'z';
  Assert(not (c in ['a', 'd'..'y', '0']));
  Assert(c in ['a', 'd'..'y', 'z']);
end;