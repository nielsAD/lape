{$assertions on}

type
  TMyEnum = (z0, z1, z2, z3, z4);
  TMyRange = z1..z4;
  TMySet = set of TMyRange;
  TMyLargeSet = set of AnsiChar;

var
  a: TMyRange;
  b: TMySet;
  c: TMyLargeSet;
begin
  a := z3;
  Assert(a =  z3, 'a <> z3');
  Assert(a <> z1, 'a = z1');

  b := [z1, z4];
  Assert(b = [z1, z4],   'b <> [z1, z4]');
  Assert(b <> [z1, z3],  'b = [z1, z3]');
  Assert(not (a in b), 'a in b');
  Assert(Length(b) = 2);

  b := b + a;
  Assert(b = [z1, z3..z4], 'b <> [z1, z3..z4]');
  Assert(Length(b) = 3);

  Assert(a in b,                'a not in b');
  Assert(TMySet([z3..z4]) <= b, 'not ([z3..z4] <= b)');

  b := b - [z1];
  Assert(b = [z3..z4], 'b <> [z3..z4]');
  Assert(Length(b) = 2);

  b := b * [z2..z3];
  Assert(b = [z3], 'b <> [z3]');
  Assert(Length(b) = 1);

  Inc(a);
  Assert(a = z4, 'a <> z4');

  c := [#1..#10];
  Assert(Length(c) = 10);
  c := c + [#202..#204];
  Assert(Length(c) = 13);
  c := c + [#1..#11];
  Assert(Length(c) = 14);

  WriteLn('Passed');
end;
