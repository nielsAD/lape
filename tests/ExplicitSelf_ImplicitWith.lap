// With explicitself off a method sees its type's fields and constants; a parameter of the same name wins
type
  TPoint = record
    x, y: Int32;
    const Scale = 10;
  end;

{$explicitself off}

procedure TPoint.Show(y: Int32);
begin
  WriteLn(x, ' ', y, ' ', Scale);
end;

procedure TPoint.Nest;

  procedure Inner;
  begin
    WriteLn(x + Scale);
  end;

begin
  Inner();
end;

var
  p: TPoint;
begin
  p.x := 1;
  p.y := 2;
  p.Show(-1);
  p.Nest();
end;
